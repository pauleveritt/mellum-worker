# Copy to scripts/baseline/vast.env (git-ignored) and fill in. baseline.py reads
# it as plain KEY=VALUE lines (no shell expansion; a leading ~ is your home).
# The token goes only into the vastai CLI's environment, never onto a command line.

# Your vast.ai API key: https://cloud.vast.ai/manage-keys/
VAST_API_KEY="<insert vast.ai token>"

# The SSH key baseline.py registers with the instance and uses to reach it.
VAST_SSH_KEY="~/.ssh/id_ed25519"

# Refuse any offer dearer than this, in dollars per hour.
VAST_MAX_DPH=0.55

# Disk for the image, the 24 GB of weights and the server log, in GB.
VAST_DISK_GB=80

# The local port the SSH tunnel serves the model on: not 8000, which the apps
# the model writes default to.
LOCAL_PORT=18000
