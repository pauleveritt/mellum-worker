# The Pi version this repo ships the course against: the one install.sh,
# run.sh and install.bat install and check. One place, plain KEY=VALUE lines
# (no shell expansion), so the Windows batch file can read the same file as
# the shell scripts, the same shape as scripts/baseline/pins.env.
PI_PACKAGE=@earendil-works/pi-coding-agent
PI_VERSION=1.4.0
